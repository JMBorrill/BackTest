# Copy to .env and fill in. .env is git-ignored and must never be committed.

# Required. Any string. There is no default, and an empty value is rejected -
# the server will not start until this has a value.
API_TOKEN=

# Reported by GET /health so you can tell which environment you are pointed at.
ENVIRONMENT=sandbox

# Where the price CSVs live, relative to the repository root.
DATA_DIR=data
